{
  "name": "clockwork-carnage-dev",
  "version": "0.9.0",
  "type": "module",
  "private": true,
  "description": "Local development and testing suite for Clockwork Carnage",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:smoke": "npx playwright test tests/smoke.spec.js",
    "test:screenshots": "npx playwright test tests/screenshots.spec.js",
    "test:bots": "npx playwright test tests/bots.spec.js",
    "test:telemetry": "npx playwright test tests/telemetry.spec.js",
    "test:experts": "npx playwright test tests/experts.spec.js",
    "test:gate": "npx playwright test tests/playtest-gate.spec.js",
    "test:perf": "npx playwright test tests/perf-budget.spec.js --workers=1",
    "bench": "node scripts/bench.mjs",
    "gate": "npm run test:gate",
    "test:journeys": "npx playwright test tests/user-journeys.spec.js",
    "test:extremes": "npx playwright test tests/extremes.spec.js",
    "screenshots": "npx playwright test tests/screenshots.spec.js --headed",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "reel:record": "node scripts/reel/record.mjs sizzle",
    "reel:record:lore": "node scripts/reel/record.mjs lore",
    "report": "npx playwright show-report",
    "test:e2e": "npx playwright test",
    "test:pages": "npx playwright test --config playwright.pages.config.js",
    "release:playtest": "node scripts/release-playtest.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@vitest/coverage-v8": "^4.1.4",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  }
}
