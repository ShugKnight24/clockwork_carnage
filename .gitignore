IDEAS.md
NOTES.md
PLAN.md
REVIEW.md
ROADMAP.md
TESTING.md

archive/

# Generated changelog reports
.changelog/

# Dev scripts. The brand generator and the reel recorder are the exceptions:
# assets/brand and docs/media are built from them and can only be
# regenerated with them. The benchmark runner is documented for other
# machines (docs/REMOTE-TESTING.md).
scripts/*
!scripts/brand/
!scripts/reel/
!scripts/bench.mjs

# Playwright / automation engine — output only. The specs, the debug bridge,
# the config and package.json are tracked so a clone can install and run them.
playwright-report/
test-results/
screenshots/
.playwright/

# Node tooling
node_modules/

# Telemetry & simulation data
telemetry/
simulations/

# Forge editor (deferred to next sprint)
js/editor/

# Editor
.vscode/

# Untracked game prototypes (experimental, not part of Clockwork Carnage)
prototypes/

# Local dev tools and temporary files
tools/
tmp_grid.txt

# Documentation artifact (should be untracked)
docs/WEAPONS_ENEMIES.md
weapons_enemies.md

# Playwright MCP session data
.playwright-mcp/

# Loose capture PNGs dropped at the repo root by manual test runs
/*.png

# Benchmark reports (npm run bench)
bench-results/
